{
  "name": "holy-mission-blood-donation",
  "version": "0.1.0",
  "private": true,
  "description": "Holy Mission Blood Donation — Bangla-first community blood donor network",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:create": "tsx scripts/create-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/create-db.ts && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "vercel-build": "tsx scripts/migrate.ts && tsx scripts/seed.ts && next build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
