# Copy to .env.local and adjust. Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL=postgres://localhost:5432/holy_mission

# Long random string (32+ chars). Used to hash IP addresses for rate limiting and audit logs,
# so raw IP addresses are never stored. Generate with: openssl rand -hex 32
APP_SECRET=

# Public base URL of the site (used for absolute links in notifications and metadata)
APP_BASE_URL=http://localhost:3000

# Set to "true" only when the site is served over HTTPS (adds Secure cookies + HSTS).
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# --- Optional notification integrations -------------------------------------------------
# No SMS or email provider is bundled. In-app notifications always work.
# A generic outgoing webhook lets you connect any SMS/email relay you trust: the app POSTs
# JSON {channel, to, text} signed with HMAC-SHA256 (header X-HM-Signature) and records
# "sent" only when the webhook answers 2xx.
# NOTIFY_WEBHOOK_URL=https://example.org/hooks/holy-mission
# NOTIFY_WEBHOOK_SECRET=
# NOTIFY_WEBHOOK_CHANNEL=sms

# --- First administrator (used by `npm run admin:create`) ------------------------------
# ADMIN_PHONE=01XXXXXXXXX
# ADMIN_NAME=
# ADMIN_PASSWORD=

# --- Public contact details shown on /contact (leave empty until officially decided) ----
# PUBLIC_CONTACT_EMAIL=
# PUBLIC_CONTACT_PHONE=

# --- Hosting (see docs/DEPLOY-VERCEL.md) ------------------------------------------------
# MIGRATION_DATABASE_URL=   # optional; Supabase transaction-pooler URLs switch to port 5432 automatically
# DATABASE_POOL_MAX=        # default 3 on Vercel, 10 elsewhere
# CRON_SECRET=              # enables /api/cron/maintenance (Vercel Cron)
